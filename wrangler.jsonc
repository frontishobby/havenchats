{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "havenchats",
	"compatibility_date": "2026-06-01",
	// 정적 자산 전용 Worker(코드 없음, CPU 0) — SvelteKit adapter-static 빌드 결과(build/)만 서빙.
	// API·DB·이미지는 전부 브라우저 안(src/lib/local)에서 돌고, 저장소는 IndexedDB + Google Drive.
	// 배포: main 푸시 → Cloudflare Workers Builds(대시보드 Git 연결)가 npm run build → wrangler deploy.
	"assets": {
		"directory": "./build",
		"not_found_handling": "single-page-application"
	},
	// 커스텀 도메인(존이 이 계정에 있어야 함). 배포 시 DNS·인증서 자동 구성.
	"routes": [{ "pattern": "havenchats.com", "custom_domain": true }]
}
