# Vercel AI Gateway
# 로컬 개발(vite dev)에서는 이 파일을 .env 로 복사해 값을 채우세요.
AI_GATEWAY_API_KEY=

# Google OAuth (https://console.cloud.google.com → OAuth 2.0 클라이언트 ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# (선택) 리디렉트 URI override. 미설정 시 요청 origin + /auth/google/callback 사용.
GOOGLE_REDIRECT_URI=

# 세션 쿠키 서명용 시크릿 (긴 랜덤 문자열). 예: openssl rand -base64 48
AUTH_SECRET=

# 유저 외부 API 키(NovelAI 등) 양방향 암호화용 시크릿. 예: openssl rand -base64 48
# 미설정 시 AUTH_SECRET 으로 폴백. 바꾸면 기존 암호문은 복호화 불가(키 재등록 필요).
KEY_SECRET=

# [테스트용] 로그인 허용 이메일 화이트리스트 (쉼표 구분). 비우면 전체 허용.
ALLOWED_EMAILS=owner@example.com

# (선택) 이미지 공개 도메인. 미설정 시 /img 라우트(Worker→R2)로 서빙.
PUBLIC_IMAGE_BASE=

# wrangler 인증 (deploy / d1 migrations / dev). 로컬에서 export 해서 사용.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
